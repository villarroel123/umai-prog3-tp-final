# Impresora ESC/POS conectada al mismo equipo que ejecuta Next.js.
# Para impresora compartida en Windows: //localhost/TICKETS
# Para impresora de red: tcp://192.168.1.50:9100
IMPRESORA_INTERFACE=//localhost/TICKETS
IMPRESORA_TIPO=epson
IMPRESORA_ABRIR_CAJON=true
IMPRESORA_TIMEOUT_MS=5000
